# Server-side placeholders. Real key stays in ignored .env.
GEMINI_API_KEY=replace_with_server_side_key
# Primary is required; optional escalation stays disabled until live-verified.
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_ESCALATION_ENABLED=false
GEMINI_ESCALATION_MODEL=gemini-3.6-flash
# Disabled escalation forces primary for scans, ignoring optional scan overrides.
GEMINI_SCAN_MODEL=gemini-3.5-flash-lite
GEMINI_ESCALATION_THINKING_LEVEL=MINIMAL
AP_COMPASS_DB_PATH=runtime/ap-compass.db
