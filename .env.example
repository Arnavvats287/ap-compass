# Local development: bind to 127.0.0.1. Keep actual secrets in the backend environment.
AP_COMPASS_MODE=local
# Defaults to true in local mode and false in private mode. Accepted values: true, false.
# AP_COMPASS_UPLOADS_ENABLED=false
AP_COMPASS_UPLOAD_CAPACITY=3
# Required in private mode. Use HTTPS for remote access.
# AP_COMPASS_PRIVATE_ORIGIN=http://127.0.0.1:8000
# AP_COMPASS_PRIVATE_USERNAME=
# AP_COMPASS_PRIVATE_PASSWORD=
GEMINI_API_KEY=
# Primary is required; optional escalation stays disabled until live-verified.
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_ESCALATION_ENABLED=false
GEMINI_ESCALATION_MODEL=gemini-3.6-flash
# Disabled escalation forces primary for scans, ignoring optional scan overrides.
GEMINI_SCAN_MODEL=gemini-3.5-flash-lite
GEMINI_ESCALATION_THINKING_LEVEL=MINIMAL
AP_COMPASS_DB_PATH=runtime/ap-compass.db
AP_COMPASS_DOCUMENT_DIR=runtime/documents
